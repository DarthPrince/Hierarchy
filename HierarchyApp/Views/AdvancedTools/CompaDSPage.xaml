<Page
    x:Class="HierarchyApp.Views.AdvancedTools.CompaDSPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F0F2F5">

    <ScrollViewer Padding="0">
        <StackPanel Padding="32,24" Spacing="20" MaxWidth="1200">

            <!-- ═══ HEADER ═══════════════════════════════════════════════════ -->
            <StackPanel Spacing="4">
                <TextBlock
                    Text="CompaDS"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="#111827" />
                <TextBlock
                    Text="Compare two PIP DS revisions and identify changed and new support loads"
                    FontSize="13"
                    Foreground="#6B7280"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- ═══ INPUT FILES ══════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="8" Padding="24,20">
                <StackPanel Spacing="16">

                    <TextBlock
                        Text="Input Files"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#111827" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- OLD PIP DS file -->
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock
                                Text="OLD PIP DS file"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#374151" />
                            <Button
                                Command="{x:Bind ViewModel.PickOldFileCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                                <Grid MinHeight="52">
                                    <Rectangle
                                        Stroke="#2563EB"
                                        StrokeThickness="1.5"
                                        StrokeDashArray="5,3"
                                        RadiusX="6" RadiusY="6"
                                        Fill="White" />
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- File icon -->
                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="&#xE8A5;"
                                            FontSize="18"
                                            Foreground="#2563EB"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />
                                        <!-- Placeholder -->
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="Click to upload OLD file"
                                            Visibility="{x:Bind ViewModel.HasOldFile, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            FontSize="13"
                                            Foreground="#9CA3AF"
                                            VerticalAlignment="Center" />
                                        <!-- Filename once loaded -->
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind ViewModel.OldFileName, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasOldFile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="#111827"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                        <!-- Upload icon -->
                                        <FontIcon
                                            Grid.Column="2"
                                            Glyph="&#xE898;"
                                            FontSize="16"
                                            Foreground="#6B7280"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- NEW PIP DS file -->
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock
                                Text="NEW PIP DS file"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#374151" />
                            <Button
                                Command="{x:Bind ViewModel.PickNewFileCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                                <Grid MinHeight="52">
                                    <Rectangle
                                        Stroke="#2563EB"
                                        StrokeThickness="1.5"
                                        StrokeDashArray="5,3"
                                        RadiusX="6" RadiusY="6"
                                        Fill="White" />
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="&#xE8A5;"
                                            FontSize="18"
                                            Foreground="#2563EB"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="Click to upload NEW file"
                                            Visibility="{x:Bind ViewModel.HasNewFile, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            FontSize="13"
                                            Foreground="#9CA3AF"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind ViewModel.NewFileName, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasNewFile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="#111827"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                        <FontIcon
                                            Grid.Column="2"
                                            Glyph="&#xE898;"
                                            FontSize="16"
                                            Foreground="#6B7280"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ THRESHOLDS ═══════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="8" Padding="24,20">
                <StackPanel Spacing="16">

                    <TextBlock
                        Text="Thresholds"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#111827" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Delta Value Threshold (kN) -->
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock
                                Text="Delta Value Threshold (kN)"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#374151" />
                            <NumberBox
                                Value="{x:Bind ViewModel.DeltaValueThreshold, Mode=TwoWay}"
                                PlaceholderText="e.g., 5"
                                Minimum="0"
                                SpinButtonPlacementMode="Hidden"
                                ValidationMode="InvalidInputOverwritten"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Delta % Threshold -->
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock
                                Text="Delta % Threshold"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#374151" />
                            <NumberBox
                                Value="{x:Bind ViewModel.DeltaPercentThreshold, Mode=TwoWay}"
                                PlaceholderText="e.g., 10"
                                Minimum="0"
                                SpinButtonPlacementMode="Hidden"
                                ValidationMode="InvalidInputOverwritten"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="Cells are colored when values exceed thresholds. Line status is determined by Category Value × Category Percent logic."
                        FontSize="12"
                        Foreground="#6B7280"
                        TextWrapping="Wrap" />

                </StackPanel>
            </Border>

            <!-- ═══ COMPARE BUTTON ════════════════════════════════════════════ -->
            <Button
                Command="{x:Bind ViewModel.CompareCommand}"
                Content="Compare"
                HorizontalAlignment="Center"
                MinWidth="160"
                Padding="32,10"
                FontSize="14"
                FontWeight="SemiBold"
                Background="#2563EB"
                Foreground="White"
                CornerRadius="6" />

        </StackPanel>
    </ScrollViewer>
</Page>
